{
  "name": "fabtwin",
  "version": "0.1.0",
  "private": true,
  "description": "FabTwin: a semiconductor fab MES and deterministic discrete-event simulation, played as a 3D shift-lead game.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:services": "tsc --noEmit -p services/opcua-bridge/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "tsx scripts/calibrate.ts",
    "mock-live": "tsx scripts/mock-live-server.ts",
    "sparkplug-sim": "tsx scripts/sparkplug-edge-sim.ts",
    "fab-in-a-box": "bash scripts/fab-in-a-box.sh",
    "live-probe": "tsx scripts/live-probe.ts",
    "opcua-sample-server": "npm --prefix services/opcua-bridge run sample-server",
    "opcua-bridge": "npm --prefix services/opcua-bridge run bridge",
    "openapi": "tsx scripts/write-openapi.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "camera-controls": "^3.1.2",
    "mqtt": "^5.16.0",
    "next": "^16.4.0",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
