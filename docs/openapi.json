    "/exports/{file}": {
      "get": {
        "operationId": "export",
        "summary": "CSV and JSON exports",
        "description": "lot-history.(csv|json): every genealogy entry of every lot up to t, or one lot with ?lot=. shift-report.(csv|json): the full shift report for a seed, with the autopilot comparison.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "lot-history.csv",
                "lot-history.json",
                "shift-report.csv",
                "shift-report.json"
              ]
            }
          },
          {
            "name": "lot",
            "in": "query",
            "description": "lot-history only",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "simulation (default) or live. live needs FABTWIN_LIVE_URLS on a self-hosted server.",
            "schema": {
              "type": "string",
              "enum": [
                "simulation",
                "live"
              ],
              "default": "simulation"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "description": "Simulation seed. The same seed and t always give the same answer.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999,
              "default": 1
            }
          },
          {
            "name": "t",
            "in": "query",
            "description": "Simulated seconds into the 4 hour shift.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14400,
              "default": 7200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown export or lot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
