          "503": {
            "description": "The live source is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "E10State": {
        "type": "string",
        "enum": [
          "PRODUCTIVE",
          "STANDBY",
          "ENGINEERING",
          "SCHEDULED_DOWN",
          "UNSCHEDULED_DOWN"
        ]
      },
      "Meta": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "simulation",
              "live"
            ]
          },
          "simulated": {
            "type": "boolean"
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "atS": {
            "type": "number"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "shiftS": {
            "type": "number"
          }
        },
        "required": [
          "source",
          "simulated",
          "seed",
          "atS",
          "at",
          "shiftS"
        ],
        "additionalProperties": false
      },
      "Lot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "hot": {
            "type": "boolean"
          },
          "expedited": {
            "type": "boolean"
          },
          "held": {
            "type": "boolean"
          },
          "holdReason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "operator",
              "spc",
              null
            ]
          },
          "step": {
            "type": "integer"
          },
          "steps": {
            "type": "integer"
          },
          "recipe": {
            "type": "string"
          },
          "bay": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "transit",
              "atTool",
              "processing",
              "done"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "stocker",
                  "tool",
                  "vehicle",
                  "gone"
                ]
              },
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "toolId": {
            "type": [
              "string",
              "null"
            ]
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time"
          },
          "due": {
            "type": "string",
            "format": "date-time"
          },
          "queueTimeLeftS": {
            "type": [
              "number",
              "null"
            ]
          },
          "queueTimeViolations": {
            "type": "integer"
          },
          "excursionFlag": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "route",
          "hot",
          "expedited",
          "held",
          "holdReason",
          "step",
          "steps",
          "recipe",
          "bay",
          "status",
          "location",
          "toolId",
          "releasedAt",
          "due",
          "queueTimeLeftS",
          "queueTimeViolations",
          "excursionFlag"
        ],
        "additionalProperties": false
      },
      "LotList": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lot"
            }
          }
        },
        "required": [
          "meta",
          "total",
          "limit",
          "offset",
          "lots"
        ],
        "additionalProperties": false
      },
      "HistoryRow": {
        "type": "object",
        "properties": {
          "lotId": {
            "type": "string"
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "hot": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "atS": {
            "type": "number"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string"
          },
          "toolId": {
            "type": [
              "string",
              "null"
            ]
          },
          "stepIndex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
