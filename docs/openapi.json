{
  "openapi": "3.1.0",
  "info": {
    "title": "FabTwin MES API",
    "version": "1.0.0",
    "description": "Read-only REST API over FabTwin's fab model: lots, WIP by step, tool states, alarms and KPIs, plus CSV and JSON exports. By default it serves the deterministic simulation as a function of seed and t, and every response says so in meta.simulated. With FABTWIN_LIVE_URLS set on a self-hosted server, source=live serves the state derived from a live FabTwin event feed.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/lots": {
      "get": {
        "operationId": "listLots",
        "summary": "Lots in the fab",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "description": "simulation (default) or live. live needs FABTWIN_LIVE_URLS on a self-hosted server.",
            "schema": {
              "type": "string",
              "enum": [
                "simulation",
                "live"
              ],
              "default": "simulation"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "description": "Simulation seed. The same seed and t always give the same answer.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999,
              "default": 1
            }
          },
          {
            "name": "t",
            "in": "query",
            "description": "Simulated seconds into the 4 hour shift.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14400,
              "default": 7200
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "waiting",
                "transit",
                "atTool",
                "processing"
              ]
            }
          },
          {
            "name": "bay",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "LITHO",
                "ETCH",
                "DEP",
                "CMP",
                "METRO"
              ]
            }
          },
          {
            "name": "hot",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "held",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Matches lot id, route, recipe or tool id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lots, sorted by id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotList"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The live source is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/lots/{id}": {
      "get": {
        "operationId": "getLot",
        "summary": "One lot with its genealogy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "simulation (default) or live. live needs FABTWIN_LIVE_URLS on a self-hosted server.",
            "schema": {
              "type": "string",
              "enum": [
                "simulation",
                "live"
              ],
              "default": "simulation"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "description": "Simulation seed. The same seed and t always give the same answer.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999,
              "default": 1
            }
          },
          {
            "name": "t",
            "in": "query",
            "description": "Simulated seconds into the 4 hour shift.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14400,
              "default": 7200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The lot and its history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LotDetail"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such lot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The live source is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
